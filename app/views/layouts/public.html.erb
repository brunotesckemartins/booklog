<!DOCTYPE html>
<html>
  <head>
    <title><%= @item&.title || "Booklog" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "application", media: "all" %>
  </head>

  <body class="bg-zinc-950 text-zinc-100 min-h-screen font-sans">
    <main class="max-w-2xl mx-auto px-6 py-24">
      <%= yield %>
    </main>
  </body>
</html>
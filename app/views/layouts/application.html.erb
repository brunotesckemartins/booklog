<!DOCTYPE html>
<html>
  <head>
    <title>Booklog</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "application", media: "all" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-zinc-950 text-zinc-100 min-h-screen font-sans">
    <nav class="border-b border-zinc-800 px-6 py-3">
  <div class="max-w-5xl mx-auto flex justify-between items-center">
    <a href="/" class="flex items-center gap-2">
      <img src="<%= asset_path('image.png') %>" class="h-14 w-14 object-contain" style="filter: invert(1);" alt="Booklog">
      <span class="text-base font-semibold text-zinc-100 tracking-tight">Booklog</span>
    </a>
    <div class="flex gap-3 items-center text-sm">
      <% if user_signed_in? %>
        <%= link_to "Backlog", items_path, class: "text-zinc-400 hover:text-zinc-100 transition" %>
        <%= link_to "Coleções", collections_path, class: "text-zinc-400 hover:text-zinc-100 transition" %>
        <%= button_to "Sair", destroy_user_session_path, method: :delete, class: "text-zinc-500 hover:text-zinc-200 transition bg-transparent border-0 cursor-pointer" %>
      <% end %>
    </div>
  </div>
</nav>

    <main class="max-w-5xl mx-auto px-6 py-10">
      <% if notice %>
        <div class="bg-zinc-800 text-zinc-300 px-4 py-3 rounded-md mb-6 text-sm">
          <%= notice %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
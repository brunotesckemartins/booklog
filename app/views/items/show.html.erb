<div class="max-w-2xl">
  <div class="flex gap-6 mb-8">
    <% if @item.cover_url.present? %>
      <%= image_tag @item.cover_url, class: "w-28 rounded-lg shadow-md flex-shrink-0" %>
    <% end %>

    <div class="flex flex-col justify-center gap-2">
      <div class="flex gap-2">
        <span class="text-xs font-medium px-2 py-0.5 rounded bg-zinc-800 text-zinc-400">
          <%= @item.item_type.upcase %>
        </span>
        <span class="text-xs font-medium px-2 py-0.5 rounded bg-zinc-800 text-zinc-400">
          <%= @item.status.humanize %>
        </span>
      </div>
      <h1 class="text-2xl font-semibold text-zinc-100"><%= @item.title %></h1>
      <p class="text-zinc-500 text-sm"><%= @item.author %></p>
      <% if @item.rating.present? %>
        <p class="text-yellow-500 text-sm"><%= "★" * @item.rating %><%= "☆" * (5 - @item.rating) %></p>
      <% end %>
    </div>
  </div>

  <div class="border border-zinc-800 rounded-lg divide-y divide-zinc-800">
    <% if @item.publisher.present? %>
      <div class="px-5 py-4">
        <p class="text-xs text-zinc-500 mb-1">Editora</p>
        <p class="text-zinc-200 text-sm"><%= @item.publisher %></p>
      </div>
    <% end %>

    <% if @item.year.present? %>
      <div class="px-5 py-4">
        <p class="text-xs text-zinc-500 mb-1">Ano</p>
        <p class="text-zinc-200 text-sm"><%= @item.year %></p>
      </div>
    <% end %>

    <% if @item.purchase_link.present? %>
      <div class="px-5 py-4">
        <p class="text-xs text-zinc-500 mb-1">Onde comprar</p>
        <%= link_to "Ver link", @item.purchase_link, target: "_blank", class: "text-zinc-300 hover:text-white text-sm underline underline-offset-2 transition" %>
      </div>
    <% end %>

    <% if @item.review.present? %>
      <div class="px-5 py-4">
        <p class="text-xs text-zinc-500 mb-2">Resenha</p>
        <div class="text-zinc-300 text-sm prose prose-invert prose-sm max-w-none"><%= @item.review %></div>
      </div>
    <% end %>
  </div>

  <div class="mt-6 p-4 bg-zinc-900 border border-zinc-800 rounded-lg">
  <p class="text-xs text-zinc-500 mb-2">Link público</p>
  <div class="flex gap-2 items-center">
    <code class="text-xs text-zinc-300 bg-zinc-800 px-2 py-1 rounded flex-1 truncate">
      <%= request.base_url %><%= public_item_path(@item.public_token) %>
    </code>
    <%= link_to "Abrir", public_item_path(@item.public_token), target: "_blank", class: "text-xs bg-zinc-700 hover:bg-zinc-600 text-zinc-200 px-3 py-1 rounded transition" %>
  </div>
</div>

  <div class="flex gap-3 mt-6">
    <%= link_to "Editar", edit_item_path(@item), class: "bg-zinc-100 hover:bg-zinc-300 text-zinc-900 text-sm px-4 py-2 rounded-md transition font-medium" %>
    <%= button_to "Excluir", item_path(@item), method: :delete, data: { turbo_confirm: "Tem certeza?" }, class: "bg-zinc-800 hover:bg-red-900 text-zinc-300 hover:text-red-200 text-sm px-4 py-2 rounded-md transition cursor-pointer border-0" %>
    <%= link_to "Voltar", items_path, class: "text-zinc-500 hover:text-zinc-200 text-sm px-4 py-2 transition" %>
  </div>
</div>
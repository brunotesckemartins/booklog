<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-semibold text-zinc-100">Meu Backlog</h1>
  <%= link_to "+ Adicionar", new_item_path, class: "bg-zinc-100 hover:bg-zinc-300 text-zinc-900 text-sm px-3 py-1.5 rounded-md transition font-medium" %>
</div>

<%# Filtros %>
<div class="flex flex-wrap gap-2 mb-8">
  <%= link_to "Todos", items_path, class: "text-xs px-3 py-1.5 rounded-md border transition #{params[:item_type].blank? && params[:status].blank? ? 'bg-zinc-100 text-zinc-900 border-zinc-100' : 'border-zinc-700 text-zinc-400 hover:border-zinc-500 hover:text-zinc-200'}" %>
  <div class="w-px bg-zinc-800 mx-1"></div>
  <%= link_to "Mangá", items_path(item_type: "manga", status: params[:status]), class: "text-xs px-3 py-1.5 rounded-md border transition #{params[:item_type] == 'manga' ? 'bg-zinc-100 text-zinc-900 border-zinc-100' : 'border-zinc-700 text-zinc-400 hover:border-zinc-500 hover:text-zinc-200'}" %>
  <%= link_to "HQ", items_path(item_type: "hq", status: params[:status]), class: "text-xs px-3 py-1.5 rounded-md border transition #{params[:item_type] == 'hq' ? 'bg-zinc-100 text-zinc-900 border-zinc-100' : 'border-zinc-700 text-zinc-400 hover:border-zinc-500 hover:text-zinc-200'}" %>
  <%= link_to "Livro", items_path(item_type: "livro", status: params[:status]), class: "text-xs px-3 py-1.5 rounded-md border transition #{params[:item_type] == 'livro' ? 'bg-zinc-100 text-zinc-900 border-zinc-100' : 'border-zinc-700 text-zinc-400 hover:border-zinc-500 hover:text-zinc-200'}" %>
  <div class="w-px bg-zinc-800 mx-1"></div>
  <%= link_to "Quero ler", items_path(status: "quero_ler", item_type: params[:item_type]), class: "text-xs px-3 py-1.5 rounded-md border transition #{params[:status] == 'quero_ler' ? 'bg-zinc-100 text-zinc-900 border-zinc-100' : 'border-zinc-700 text-zinc-400 hover:border-zinc-500 hover:text-zinc-200'}" %>
  <%= link_to "Lendo", items_path(status: "lendo", item_type: params[:item_type]), class: "text-xs px-3 py-1.5 rounded-md border transition #{params[:status] == 'lendo' ? 'bg-zinc-100 text-zinc-900 border-zinc-100' : 'border-zinc-700 text-zinc-400 hover:border-zinc-500 hover:text-zinc-200'}" %>
  <%= link_to "Lido", items_path(status: "lido", item_type: params[:item_type]), class: "text-xs px-3 py-1.5 rounded-md border transition #{params[:status] == 'lido' ? 'bg-zinc-100 text-zinc-900 border-zinc-100' : 'border-zinc-700 text-zinc-400 hover:border-zinc-500 hover:text-zinc-200'}" %>
</div>

<% if @items.empty? %>
  <div class="text-center py-24">
    <p class="text-4xl mb-4">📚</p>
    <p class="text-lg font-medium text-zinc-400">Nenhum item encontrado.</p>
    <p class="mt-1 text-sm text-zinc-600">Tente outro filtro ou adicione novos itens!</p>
  </div>
<% else %>
  <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
    <% @items.each do |item| %>
      <div class="group relative flex flex-col rounded-lg overflow-hidden border border-zinc-800 hover:border-zinc-600 transition-all duration-200">

        <%# Menu de três pontinhos %>
        <div class="absolute top-2 right-2 z-10">
          <details class="relative">
            <summary class="list-none cursor-pointer bg-zinc-950/80 rounded-md px-1.5 py-0.5 text-zinc-400 hover:text-zinc-100 text-lg leading-none">⋯</summary>
            <div class="absolute right-0 mt-1 w-40 bg-zinc-900 border border-zinc-700 rounded-lg shadow-xl z-20 overflow-hidden">
              <%= link_to "✏️ Editar", edit_item_path(item), class: "block px-4 py-2 text-xs text-zinc-300 hover:bg-zinc-800 transition" %>
              <%= link_to "📦 Coleção", edit_item_path(item, anchor: "collection"), class: "block px-4 py-2 text-xs text-zinc-300 hover:bg-zinc-800 transition" %>
              <%= button_to "🗑️ Excluir", item_path(item), method: :delete, data: { turbo_confirm: "Tem certeza?" }, class: "w-full text-left px-4 py-2 text-xs text-red-400 hover:bg-zinc-800 transition border-0 bg-transparent cursor-pointer" %>
            </div>
          </details>
        </div>

        <%= link_to item_path(item), class: "flex flex-col flex-1" do %>
          <div class="aspect-[2/3] bg-zinc-900 overflow-hidden relative">
            <% if item.cover_url.present? %>
              <%= image_tag item.cover_url, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" %>
            <% else %>
              <div class="w-full h-full flex items-center justify-center text-zinc-700 text-4xl">📖</div>
            <% end %>
            <div class="absolute top-2 left-2">
              <span class="text-xs font-medium px-1.5 py-0.5 rounded bg-zinc-950/80 text-zinc-400 backdrop-blur-sm">
                <%= item.item_type.upcase %>
              </span>
            </div>
          </div>
          <div class="p-2.5 flex flex-col gap-0.5 bg-zinc-900">
            <h2 class="text-xs font-semibold text-zinc-100 leading-tight line-clamp-2 group-hover:text-zinc-300 transition"><%= item.title %></h2>
            <p class="text-zinc-500 text-xs truncate"><%= item.author %></p>
            <div class="flex justify-between items-center mt-1">
              <span class="text-xs text-zinc-600"><%= item.status.humanize %></span>
              <% if item.rating.present? %>
                <span class="text-yellow-500 text-xs"><%= "★" * item.rating %></span>
              <% end %>
            </div>
          </div>
        <% end %>

      </div>
    <% end %>
  </div>
<% end %>
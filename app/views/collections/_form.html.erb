<%= form_with model: collection, class: "space-y-5 max-w-2xl" do |f| %>
  <% if collection.errors.any? %>
    <div class="bg-zinc-800 text-zinc-300 px-4 py-3 rounded-md text-sm">
      <ul class="space-y-1">
        <% collection.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, "Título", class: "block text-xs text-zinc-400 mb-1.5" %>
    <%= f.text_field :title, class: "w-full bg-zinc-900 border border-zinc-800 rounded-md px-3 py-2 text-zinc-100 text-sm focus:outline-none focus:border-zinc-500 transition" %>
  </div>

  <div>
    <%= f.label :description, "Descrição", class: "block text-xs text-zinc-400 mb-1.5" %>
    <%= f.text_area :description, rows: 3, class: "w-full bg-zinc-900 border border-zinc-800 rounded-md px-3 py-2 text-zinc-100 text-sm focus:outline-none focus:border-zinc-500 transition" %>
  </div>

  <%= f.submit "Salvar", class: "bg-zinc-100 hover:bg-zinc-300 text-zinc-900 text-sm px-5 py-2 rounded-md transition font-medium cursor-pointer" %>
<% end %>
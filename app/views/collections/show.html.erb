<div class="flex justify-between items-center mb-2">
  <h1 class="text-2xl font-semibold text-zinc-100"><%= @collection.title %></h1>
  <div class="flex gap-2">
    <%= link_to "Editar", edit_collection_path(@collection), class: "text-xs bg-zinc-800 hover:bg-zinc-700 text-zinc-300 px-3 py-1.5 rounded-md transition" %>
    <%= button_to "Excluir", collection_path(@collection), method: :delete, data: { turbo_confirm: "Tem certeza?" }, class: "text-xs bg-zinc-800 hover:bg-red-900 text-zinc-300 hover:text-red-200 px-3 py-1.5 rounded-md transition cursor-pointer border-0" %>
  </div>
</div>

<% if @collection.description.present? %>
  <p class="text-zinc-500 text-sm mb-8"><%= @collection.description %></p>
<% end %>

<div class="flex justify-between items-center mb-4">
  <p class="text-xs text-zinc-600"><%= @items.count %> <%= @items.count == 1 ? "item" : "itens" %></p>
</div>

<% if @items.empty? %>
  <div class="text-center py-24">
    <p class="text-4xl mb-4">📖</p>
    <p class="text-lg font-medium text-zinc-400">Nenhum item nesta coleção.</p>
    <p class="mt-1 text-sm text-zinc-600">Adicione itens e vincule a esta coleção!</p>
  </div>
<% else %>
  <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
    <% @items.each do |item| %>
      <%= link_to item_path(item), class: "group flex flex-col rounded-lg overflow-hidden border border-zinc-800 hover:border-zinc-600 transition-all duration-200" do %>
        <div class="aspect-[2/3] bg-zinc-900 overflow-hidden relative">
          <% if item.cover_url.present? %>
            <%= image_tag item.cover_url, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" %>
          <% else %>
            <div class="w-full h-full flex items-center justify-center text-zinc-700 text-4xl">📖</div>
          <% end %>
          <div class="absolute top-2 left-2">
            <span class="text-xs font-medium px-1.5 py-0.5 rounded bg-zinc-950/80 text-zinc-400">
              <%= item.item_type.upcase %>
            </span>
          </div>
        </div>
        <div class="p-2.5 flex flex-col gap-0.5 bg-zinc-900">
          <h2 class="text-xs font-semibold text-zinc-100 leading-tight line-clamp-2 group-hover:text-zinc-300 transition"><%= item.title %></h2>
          <p class="text-zinc-500 text-xs truncate"><%= item.author %></p>
          <div class="flex justify-between items-center mt-1">
            <span class="text-xs text-zinc-600"><%= item.status.humanize %></span>
            <% if item.rating.present? %>
              <span class="text-yellow-500 text-xs"><%= "★" * item.rating %></span>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>

<div class="mt-6 flex gap-3">
  <%= link_to "+ Adicionar item", new_item_path(collection_id: @collection.id), class: "bg-zinc-100 hover:bg-zinc-300 text-zinc-900 text-sm px-3 py-1.5 rounded-md transition font-medium" %>
  <%= link_to "← Voltar", collections_path, class: "text-zinc-500 hover:text-zinc-200 text-sm transition py-1.5" %>
</div>
<div class="flex justify-between items-center mb-8">
  <h1 class="text-2xl font-semibold text-zinc-100">Coleções</h1>
  <%= link_to "+ Nova Coleção", new_collection_path, class: "bg-zinc-100 hover:bg-zinc-300 text-zinc-900 text-sm px-3 py-1.5 rounded-md transition font-medium" %>
</div>

<% if @collections.empty? %>
  <div class="text-center py-24">
    <p class="text-4xl mb-4">📦</p>
    <p class="text-lg font-medium text-zinc-400">Nenhuma coleção ainda.</p>
    <p class="mt-1 text-sm text-zinc-600">Agrupe seus itens em coleções!</p>
  </div>
<% else %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <% @collections.each do |collection| %>
      <%= link_to collection_path(collection), class: "group flex flex-col gap-2 p-5 rounded-lg border border-zinc-800 hover:border-zinc-600 bg-zinc-900 transition" do %>
        <h2 class="text-base font-semibold text-zinc-100 group-hover:text-zinc-300 transition"><%= collection.title %></h2>
        <% if collection.description.present? %>
          <p class="text-zinc-500 text-sm line-clamp-2"><%= collection.description %></p>
        <% end %>
        <p class="text-zinc-600 text-xs mt-auto"><%= collection.items.count %> <%= collection.items.count == 1 ? "item" : "itens" %></p>
      <% end %>
    <% end %>
  </div>
<% end %>